# Exclude dependency and build folders immediately without allow prefixes (prevents Git deep recursion)
node_modules/
dist/
out/
.dub/
build/
*.exe
*.pdb
*.obj
*.lib

# Ignore everything by default
*

# Allow directory structures
!*/
!source/
!source/prohelp/
!site/
!examples/
!embed/
!changelog-details/
!docs/
!docs/**
!docs/**/*.adoc
!site/public/
!site/public/**
!.github/
!.github/workflows/

# Allow specific root files
!.gitignore
!README.adoc
!CHANGELOG.md
!LICENSE
!COPYING
!dub.json
!help.sdl
!embed/help.sdl

# Allow source files
!source/app.d
!source/help_main.d
!source/prohelp/*.d
!examples/*.sdl
!examples/*.cmk
!examples/*.md
!examples/*.adoc
!examples/*.markdown
!changelog-details/*.md
!docs/**
!docs/**/*.adoc
!docs/**/*.yml
!.github/workflows/*.yml

# Allow website source files
!site/package.json
!site/pnpm-lock.yaml
!site/tsconfig*.json
!site/vite.config.ts
!site/index.html
!site/public/
!site/public/**
!site/src/
!site/src/**/*
